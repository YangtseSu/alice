{
  "expo": {
    "name": "Alice 听写",
    "slug": "alice-dictation",
    "version": "0.6.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vvenv.alice",
      "infoPlist": {
        "NSCameraUsageDescription": "用于拍摄单词图片进行 OCR 识别",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A2B4A"
      },
      "package": "com.vvenv.alice",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "versionCode": 10
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "./plugins/withGradleJvmArgs",
      [
        "expo-image-picker",
        {
          "cameraPermission": "用于拍摄单词图片进行 OCR 识别"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1A2B4A",
          "dark": {
            "image": "./assets/icon.png",
            "backgroundColor": "#1A2B4A"
          }
        }
      ]
    ],
    "updates": {
      "enabled": false
    },
    "experiments": {
      "baseUrl": "/app"
    },
    "extra": {
      "zhipuBaseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "visionModel": "glm-4v-flash",
      "eas": {
        "projectId": "3f613194-d6d7-4504-b13f-c4e64a0cc8e9"
      }
    },
    "owner": "yangtse"
  }
}
